<?xml version="1.0" encoding="utf-8"?>
<!--
    §11: "Your weights stay on the phone. Nothing is uploaded, sold or shared."
    Cloud backup is therefore off; a direct device-to-device transfer stays, because
    it never leaves the user's own hands.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="weight-tracker.db" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
