<?xml version="1.0" encoding="utf-8"?>
<!--
    Layers generated from assets/icon.png by assets/make_launcher_icon.py.
    Background is the source plate's gradient, bled past the mask; foreground is
    the figure, sized so the mask crops it below the hands like the Play store
    icon does. Regenerate with the script rather than editing the PNGs.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
